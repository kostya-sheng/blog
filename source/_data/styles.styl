// Custom styles, loaded after NexT's own (custom_file_path.style in _config.next.yml).

// Typography
// --------------------------------------------------
// Wrapped titles get lines of even length instead of a lone character on the
// last line. Browsers without text-wrap support ignore this.
// No text-wrap: pretty on paragraphs: Safari re-breaks the whole paragraph
// for it, and with justified text that blows up the spacing inside lines.
.posts-expand .post-title, .post-body h1, .post-body h2, .post-body h3, .post-body h4, .post-body h5, .post-body h6 {
  text-wrap: balance;
}

// Headings would inherit justify from .post-body and stretch their balanced lines.
.post-body h1, .post-body h2, .post-body h3, .post-body h4, .post-body h5, .post-body h6 {
  text-align: start;
}

// Phones: less empty space between the post title and the text.
+mobile() {
  .posts-expand .post-header {
    margin-bottom: 30px;
  }

  .posts-expand .post-title {
    font-size: 1.375em;
  }
}

// Site logo
// --------------------------------------------------
// The wordmark replaces the text title. The title text stays in the page for
// search engines and screen readers, pushed out of the box. The header is
// #222 in both light and dark mode, so it always uses the light-text variant.
// The negative margins take back the empty space built into the SVG.
.site-title {
  aspect-ratio: 530 / 160;
  background: url('/images/kostyas-lair-logo-dark.svg') center / contain no-repeat;
  margin: -12px 0;
  overflow: hidden;
  text-indent: 100%;
  white-space: nowrap;
  width: 220px;
}

// Post images
// --------------------------------------------------
.post-body {
  // Keep portrait photos and phone screenshots within one screen.
  img {
    max-height: 80vh;
  }

  // Captions come from the image title, see scripts/post-images.js.
  figure.post-figure {
    margin: 0 auto 25px;

    img {
      margin-bottom: 0;
    }

    figcaption {
      color: var(--blockquote-color);
      font-size: $font-size-smaller;
      font-weight: normal;
      line-height: 1.6;
      margin: 10px auto 0;
    }
  }

  // Images written on the same line sit side by side.
  .post-image-row {
    align-items: flex-start;
    display: flex;
    gap: 10px;
    margin-bottom: 25px;

    > img, > figure.post-figure {
      flex: 1 1 0;
      margin: 0;
      min-width: 0;
    }

    img {
      margin-bottom: 0;
      object-fit: contain;
    }
  }
}

// Post banners
// --------------------------------------------------
// Each post opens with `{% asset_img post-banner banner.svg %}` and a `---` divider.
.post-body img.post-banner {
  width: 100%;

  // Keep the divider close, so banner and divider read as one header.
  + hr {
    margin-top: 20px;
  }
}

// Phones: at text width the 8:1 banner is under 50px tall. Run it edge to edge
// and crop it to 28:5 from the left, keeping the right side where the main
// illustration sits.
+mobile() {
  .post-body img.post-banner {
    aspect-ratio: 28 / 5;
    margin-left: calc(50% - 50vw);
    max-width: none;
    object-fit: cover;
    object-position: right center;
    width: 100vw;
  }
}
